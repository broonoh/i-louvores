@*
    Aba Configuração — aparência do telão, de forma direta:
      1. clique no texto da pré-visualização que quer mudar (título, letra, refrão…);
      2. escolha a cor na paleta e aumente/diminua a fonte com A− / A+.
    As alterações aparecem primeiro só nesta pré-visualização; o telão só muda ao clicar em "Aplicar no telão".
*@
@inject ProjectionService Projection
@inject SettingsStore Settings
@inject FontService Fonts
@inject GalleryService Gallery
@inject MediaLibraryService Media
@inject IJSRuntime JS
@inject SongService SongStore
@implements IDisposable

<div class="cfg">
    <div class="cfg-top">
        <div class="segmented" role="tablist">
            <button class="@(_mode == Mode.Song ? "active" : null)" @onclick="() => SetMode(Mode.Song)">🎵 Louvor</button>
            <button class="@(_mode == Mode.Bible ? "active" : null)" @onclick="() => SetMode(Mode.Bible)">📖 Bíblia</button>
            <button class="@(_mode == Mode.Clock ? "active" : null)" @onclick="() => SetMode(Mode.Clock)">⏱ Relógio</button>
        </div>
        <span class="cfg-hint">
            @if (_mode == Mode.Song)
            {
                <span>🖱 <b>Arraste o mouse</b> sobre as palavras para colorir só essas (neste louvor) ·
                    <b>clique</b> em uma parte do texto para mudar todos os louvores</span>
            }
            else
            {
                <span>👆 Clique no texto da imagem que quer mudar</span>
            }
        </span>
        <span class="spacer"></span>
        <button @onclick="Reset" title="Volta às cores e fontes originais (padrão do I-LOUVORES) — ainda precisa de Aplicar">↺ Restaurar padrão</button>
    </div>

    @if (Pending)
    {
        <div class="cfg-pending">
            <span>✏ Tem alterações que ainda <b>não estão no telão</b>. Veja na pré-visualização abaixo e, se gostar, aplique.</span>
            <span class="spacer"></span>
            <button class="primary" @onclick="ApplyToScreen">✔ Aplicar no telão</button>
            <button @onclick="Discard">Descartar</button>
        </div>
    }
    else if (_appliedMessage)
    {
        <div class="cfg-applied">✔ Aplicado no telão e guardado.</div>
    }

    <div class="cfg-body">
        @* ---------------- Pré-visualização clicável ---------------- *@
        <div class="cfg-preview" style="@ProjectionCss.Vars(_s)">
            @if (_mode == Mode.Song)
            {
                <div class="cfg-song-bar">
                    <div class="cfg-song-search">
                        <input type="search" placeholder="Escolher louvor (nº ou nome)…" @bind="_songQuery" @bind:event="oninput" @bind:after="SearchSongsAsync" />
                        @if (_songResults.Count > 0)
                        {
                            <div class="cfg-song-results">
                                @foreach (var r in _songResults)
                                {
                                    <button @onclick="() => OpenSongAsync(r)"><span class="muted">@r.DisplayNumber</span> @r.Title <span class="muted">· @r.Collection</span></button>
                                }
                            </div>
                        }
                    </div>
                    @if (_song is not null)
                    {
                        <b class="ellipsis">@_song.Title</b>
                        <button disabled="@(_slide <= 0)" @onclick="() => GoSlide(-1)">◀</button>
                        <span class="muted">slide @(_slide + 1)/@SongSlides.Count</span>
                        <button disabled="@(_slide >= SongSlides.Count - 1)" @onclick="() => GoSlide(+1)">▶</button>
                        <button class="primary" @onclick="ProjectPreviewSong" title="Esta pré-visualização é só um rascunho — clique aqui para pôr ESTE louvor no telão de verdade">▶ Projetar no telão</button>
                    }
                </div>
                <div class="muted small cfg-preview-note">
                    Esta tela é uma pré-visualização separada do telão. Cor/fonte/tamanho só valem para todos os louvores depois de "Aplicar no telão" — mas o louvor mostrado aqui só vai pro telão se você clicar em "▶ Projetar no telão".
                </div>

                @if (_song is not null && SongSlides.Count > 0)
                {
                    <div class="cfg-screen" @ref="_cfgRoot" data-picked="@PickName(_target)"
                         style="@SongBg()">
                        @if (_slide == 0)
                        {
                            <div class="cfg-title" data-t="title" @ref="_fitTitle" style="justify-content:@JustifyFor(_s.SongTitleAlign)">@_song.Title</div>
                        }
                        <div class="cfg-lyrics @(_slide == 0 ? null : "full")" @ref="_fit1">
                            <SlideText Text="@SongSlides[_slide]" Pickable="true" />
                        </div>
                    </div>
                }
            }
            else if (_mode == Mode.Bible)
            {
                <div class="cfg-screen" style="@Bg(BackgroundSlot.Bible, BackgroundSlot.Slides)">
                    <div class="@Cls(Target.BibleRef, "cfg-ref")" @ref="_fitRef" style="justify-content:@JustifyFor(_s.BibleRefAlign)" @onclick="() => Pick(Target.BibleRef)">João 3:16</div>
                    <div class="cfg-verse @Cls(Target.BibleText)" @ref="_fit3" @onclick="() => Pick(Target.BibleText)">
                        Porque Deus amou o mundo de tal maneira que deu o seu Filho unigênito, para que todo aquele que nele crê não pereça, mas tenha a vida eterna.
                    </div>
                </div>
            }
            else
            {
                <div class="cfg-screen" style="@Bg(BackgroundSlot.General, BackgroundSlot.Slides)">
                    <div class="cfg-clock @Cls(Target.Clock)" @onclick="() => Pick(Target.Clock)">00:05:00</div>
                </div>
            }
        </div>

        @* ---------------- Painel do elemento selecionado ---------------- *@
        <div class="cfg-panel">
            @if (_sel is not null)
            {
                <div class="cfg-selected text-sel">Selecionado: <b>“@_sel.Text”</b><br /><span class="muted small">só neste louvor · slide @(_slide + 1)</span></div>
            }
            else
            {
                <div class="cfg-selected">Selecionado: <b>@Label(_target)</b>@if (_mode == Mode.Song) { <br /><span class="muted small">todos os louvores</span> }</div>
            }

            <div class="cfg-group">
                <div class="cfg-label">Cor @(_sel is not null ? "do texto selecionado" : "")</div>
                <div class="swatches">
                    @foreach (var (name, hex) in Palette)
                    {
                        var current = _sel is null && string.Equals(GetColor(_target), hex, StringComparison.OrdinalIgnoreCase);
                        <button class="swatch @(current ? "on" : null)" style="background:@hex" title="@name" @onclick="() => OnSwatch(hex)">
                            @if (current) { <span>✓</span> }
                        </button>
                    }
                </div>
                @if (_sel is not null)
                {
                    <div class="row"><button @onclick="() => ColorTextAsync(null)">Tirar a cor deste trecho</button>
                        <button class="link" @onclick="ClearTextSelectionAsync">cancelar seleção</button></div>
                }
                else
                {
                    <div class="muted small">Cor atual: @PaletteName(GetColor(_target))</div>
                }
            </div>

            @if (_sel is not null)
            {
                <div class="cfg-group">
                    <div class="cfg-label">Tamanho do texto selecionado</div>
                    <div class="sizer">
                        <button class="big" @onclick="() => SizeTextAsync(-10)" title="Diminuir só este trecho">A−</button>
                        <button class="big" @onclick="() => SizeTextAsync(+10)" title="Aumentar só este trecho">A+</button>
                    </div>
                </div>
            }

            @if (_sel is null && SizeOf(_target) is { } size)
            {
                var (min, max) = SizeRange(_target);
                <div class="cfg-group">
                    <div class="cfg-label">Tamanho da letra</div>
                    <div class="sizer">
                        <button class="big" @onclick="() => ChangeSize(-1)" disabled="@(size <= min)" title="Diminuir">A−</button>
                        <span class="size-value">@size.ToString("0")</span>
                        <button class="big" @onclick="() => ChangeSize(+1)" disabled="@(size >= max)" title="Aumentar">A+</button>
                    </div>
                    <div class="muted small">Se a letra não couber no ecrã, diminui sozinha.</div>
                </div>
            }

            @if (_sel is null && _target is Target.Lyrics or Target.Chorus or Target.Paren or Target.Men or Target.Women or Target.BibleText)
            {
                <div class="cfg-group">
                    <div class="cfg-label">Espaçamento entre linhas</div>
                    <input type="range" class="cfg-slider" min="1" max="2" step="0.05" value="@LineHeight" @oninput="OnLineHeightInput" />
                    <div class="muted small">@LineHeight.ToString("0.00")× a altura da letra</div>
                </div>
            }

            @if (_sel is null && _target is Target.Title or Target.BibleRef)
            {
                <div class="cfg-group">
                    <div class="cfg-label">Alinhamento @(_target == Target.Title ? "do título" : "da referência")</div>
                    <div class="segmented" role="group">
                        <button class="@(HeadingAlign == "left" ? "active" : null)" @onclick='() => SetHeadingAlign("left")'>⯇ Esquerda</button>
                        <button class="@(HeadingAlign == "center" ? "active" : null)" @onclick='() => SetHeadingAlign("center")'>☰ Centro</button>
                        <button class="@(HeadingAlign == "right" ? "active" : null)" @onclick='() => SetHeadingAlign("right")'>⯈ Direita</button>
                    </div>
                </div>

                <div class="cfg-group">
                    <div class="cfg-label">Posição vertical @(_target == Target.Title ? "do título" : "da referência")</div>
                    <input type="range" class="cfg-slider" min="0" max="50" step="0.5" value="@HeadingTop" @oninput="OnHeadingTopInput" />
                    <div class="muted small">@HeadingTop.ToString("0.0")% do topo da tela — arraste até encaixar na faixa colorida do fundo escolhido.</div>
                </div>
            }

            @if (_mode != Mode.Clock)
            {
                <div class="cfg-group">
                    <div class="cfg-label">Fonte @FontLabel(_target)</div>
                    <select @onchange="OnFont">
                        @foreach (var f in FontChoices)
                        {
                            <option value="@f" selected="@(f == CurrentFont)" style="font-family:'@f'">@f</option>
                        }
                    </select>
                </div>
            }

            @if (_mode == Mode.Song)
            {
                <div class="cfg-group">
                    <div class="cfg-label">Fundo</div>
                    <BackgroundPickerStrip Slot="BackgroundSlot.FirstSlide" Label="1.º slide" Changed="StateHasChanged" />
                    <BackgroundPickerStrip Slot="BackgroundSlot.Slides" Label="Restantes slides" Changed="StateHasChanged" />
                </div>

                <div class="cfg-group">
                    <div class="cfg-label">Alinhamento da letra</div>
                    <div class="segmented" role="group">
                        <button class="@(_s.SongAlign is "block" or null ? "active" : null)" @onclick='() => Apply(_s with { SongAlign = "block" })'>⯇ Esquerda</button>
                        <button class="@(_s.SongAlign == "center" ? "active" : null)" @onclick='() => Apply(_s with { SongAlign = "center" })'>☰ Centro</button>
                        <button class="@(_s.SongAlign == "right" ? "active" : null)" @onclick='() => Apply(_s with { SongAlign = "right" })'>⯈ Direita</button>
                    </div>
                </div>

                <div class="cfg-group toggles-row">
                    <button class="toggle-btn @(_s.SongUppercase ? "on" : null)" @onclick="() => Apply(_s with { SongUppercase = !_s.SongUppercase })">AA Caixa alta</button>
                    <button class="toggle-btn @(_s.SongBold ? "on" : null)" @onclick="() => Apply(_s with { SongBold = !_s.SongBold })"><b>N</b> Negrito</button>
                </div>
            }
            else if (_mode == Mode.Bible)
            {
                <div class="cfg-group">
                    <div class="cfg-label">Fundo</div>
                    <BackgroundPickerStrip Slot="BackgroundSlot.Bible" Label="Bíblia" Changed="StateHasChanged" />
                </div>

                <div class="cfg-group">
                    <div class="cfg-label">Alinhamento do versículo</div>
                    <div class="segmented" role="group">
                        <button class="@(_s.BibleAlign == "left" ? "active" : null)" @onclick='() => Apply(_s with { BibleAlign = "left" })'>⯇ Esquerda</button>
                        <button class="@(_s.BibleAlign is "center" or null ? "active" : null)" @onclick='() => Apply(_s with { BibleAlign = "center" })'>☰ Centro</button>
                        <button class="@(_s.BibleAlign == "right" ? "active" : null)" @onclick='() => Apply(_s with { BibleAlign = "right" })'>⯈ Direita</button>
                    </div>
                </div>
            }

            <div class="cfg-actions">
                <button class="primary" disabled="@(!Pending)" @onclick="ApplyToScreen">✔ Aplicar no telão</button>
                <button disabled="@(!Pending)" @onclick="Discard">Descartar</button>
            </div>
        </div>
    </div>
</div>

@code {
    private enum Mode { Song, Bible, Clock }
    private enum Target { Title, Lyrics, Chorus, Paren, Men, Women, BibleRef, BibleText, Clock }

    private static readonly (string Name, string Hex)[] Palette =
    [
        ("Branco", "#ffffff"), ("Creme", "#fff3d6"), ("Amarelo", "#ffff00"), ("Amarelo claro", "#fff833"),
        ("Dourado", "#f7d868"), ("Âmbar", "#ffc600"), ("Laranja", "#ff8c00"), ("Vermelho", "#ff3b30"),
        ("Rosa", "#ff7eb6"), ("Verde", "#22c55e"), ("Verde claro", "#86efac"), ("Azul claro", "#7dd3fc"),
        ("Azul", "#3b82f6"), ("Cinza claro", "#d1d5db"), ("Preto", "#000000")
    ];

    private ElementReference _fit1, _fit3, _cfgRoot, _fitTitle, _fitRef;
    private DotNetObjectReference<SettingsTab>? _selfRef;

    // Louvor real na pré-visualização (e o rascunho da letra com cores por trecho)
    private Projecao.Models.Song? _song;
    private string _songLyrics = string.Empty;
    private string _songOriginalLyrics = string.Empty;
    private int _slide;
    private string _songQuery = string.Empty;
    private List<Projecao.Models.Song> _songResults = [];
    private TextSel? _sel;

    private sealed record TextSel(int StartLine, int StartOffset, int EndLine, int EndOffset, string Text);

    private IReadOnlyList<string> SongSlides => SongMarkup.BuildSlides(_songLyrics);

    protected override async Task OnInitializedAsync()
    {
        var first = (await SongStore.SearchAsync("alto preco", take: 1)).FirstOrDefault()
                    ?? (await SongStore.SearchAsync(null, take: 1)).FirstOrDefault();
        if (first is not null) await OpenSongAsync(first);
    }

    private async Task SearchSongsAsync() =>
        _songResults = string.IsNullOrWhiteSpace(_songQuery) ? [] : (await SongStore.SearchAsync(_songQuery, take: 8)).ToList();

    private Task OpenSongAsync(Projecao.Models.Song song)
    {
        _song = song;
        _songLyrics = _songOriginalLyrics = NormalizeLines(song.Lyrics);
        _slide = 0;
        _sel = null;
        _songQuery = string.Empty;
        _songResults = [];
        return Task.CompletedTask;
    }

    private void GoSlide(int delta)
    {
        _slide = Math.Clamp(_slide + delta, 0, Math.Max(0, SongSlides.Count - 1));
        _sel = null;
    }

    /// <summary>Põe no telão de verdade o louvor que está sendo pré-visualizado aqui (sem precisar ir à aba Louvores).</summary>
    private void ProjectPreviewSong()
    {
        if (_song is null)
            return;

        var item = QueueItemFactory.FromSong(_song, Media.Resolve(_song.BackgroundFile), Media.Resolve(_song.FirstSlideBackgroundFile));
        Projection.ProjectNow(item, _slide);
    }

    [JSInvokable]
    public Task OnPickTarget(string type) => InvokeAsync(() =>
    {
        _sel = null;
        _target = type switch
        {
            "title" => Target.Title, "chorus" => Target.Chorus, "paren" => Target.Paren,
            "men" => Target.Men, "women" => Target.Women, _ => Target.Lyrics
        };
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnTextSelected(int startLine, int startOffset, int endLine, int endOffset, string text) => InvokeAsync(() =>
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        _sel = new TextSel(startLine, startOffset, endLine, endOffset, text.Length > 60 ? text[..60] + "…" : text);
        StateHasChanged();
    });

    /// <summary>Colore só o trecho selecionado deste louvor (fica no rascunho até "Aplicar").</summary>
    private async Task ColorTextAsync(string? hex)
    {
        if (_sel is null || _song is null) return;
        var slides = SongSlides;
        if (_slide >= slides.Count) return;

        var oldStanza = slides[_slide];
        var newStanza = SongMarkup.ApplyColor(oldStanza, _sel.StartLine, _sel.StartOffset, _sel.EndLine, _sel.EndOffset, hex);
        _songLyrics = _songLyrics.Replace(oldStanza, newStanza);
        _sel = null;
        _appliedMessage = false;
        await JS.InvokeVoidAsync("projecao.clearSelection");
    }

    /// <summary>Aumenta/diminui o tamanho só do trecho selecionado deste louvor (fica no rascunho até "Aplicar").</summary>
    private async Task SizeTextAsync(int delta)
    {
        if (_sel is null || _song is null) return;
        var slides = SongSlides;
        if (_slide >= slides.Count) return;

        var oldStanza = slides[_slide];
        var newStanza = SongMarkup.ChangeSize(oldStanza, _sel.StartLine, _sel.StartOffset, _sel.EndLine, _sel.EndOffset, delta);
        _songLyrics = _songLyrics.Replace(oldStanza, newStanza);
        _sel = null;
        _appliedMessage = false;
        await JS.InvokeVoidAsync("projecao.clearSelection");
    }

    private async Task ClearTextSelectionAsync()
    {
        _sel = null;
        await JS.InvokeVoidAsync("projecao.clearSelection");
    }

    private static string NormalizeLines(string text) =>
        string.Join('\n', text.Replace("\r\n", "\n").Split('\n').Select(l => l.TrimEnd())).Trim('\n');

    private static string PickName(Target t) => t switch
    {
        Target.Title => "title", Target.Chorus => "chorus", Target.Paren => "paren",
        Target.Men => "men", Target.Women => "women", _ => "lyrics"
    };

    public void Dispose() => _selfRef?.Dispose();

    /// <summary>Depois de cada alteração, a miniatura reajusta o texto como o telão faz.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (_mode == Mode.Song && _song is not null)
            {
                _selfRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("projecao.cfgBind", _cfgRoot, _selfRef);
                await JS.InvokeVoidAsync("projecao.fitPreview", _fit1, _s.SongMaxSizePct);
                if (_slide == 0)
                    await JS.InvokeVoidAsync("projecao.fitPreview", _fitTitle, _s.SongTitleMaxSizePct, 0.78);
            }
            else if (_mode == Mode.Bible)
            {
                await JS.InvokeVoidAsync("projecao.fitPreview", _fit3, _s.BibleMaxSizePct);
                await JS.InvokeVoidAsync("projecao.fitPreview", _fitRef, _s.BibleRefMaxSizePct, 0.80);
            }
        }
        catch (JSDisconnectedException) { }
    }

    private ProjectionStyle _s = ProjectionStyle.Default;        // rascunho (o que se vê na pré-visualização)
    private ProjectionStyle _applied = ProjectionStyle.Default;  // o que está no telão
    private bool _appliedMessage;

    private bool Pending => _s != _applied || _songLyrics != _songOriginalLyrics;
    private Mode _mode = Mode.Song;
    private Target _target = Target.Lyrics;


    protected override void OnInitialized() => _s = _applied = Settings.ProjectionStyle;

    private void SetMode(Mode mode)
    {
        _mode = mode;
        _target = mode switch { Mode.Song => Target.Lyrics, Mode.Bible => Target.BibleText, _ => Target.Clock };
    }

    private void Pick(Target target) => _target = target;

    /// <summary>Só muda o rascunho (pré-visualização da aba). O telão não é tocado.</summary>
    private void Apply(ProjectionStyle style)
    {
        _s = style;
        _appliedMessage = false;
    }

    private async Task ApplyToScreen()
    {
        _applied = _s;
        Settings.ProjectionStyle = _s;
        Projection.SetStyle(_s);

        // Cores por trecho: grava a letra do louvor (atualiza-o na fila/telão se lá estiver).
        if (_song is not null && _songLyrics != _songOriginalLyrics)
        {
            _song.Lyrics = _songLyrics;
            _song = await SongStore.SaveAsync(_song);
            _songOriginalLyrics = _songLyrics;
        }
        _appliedMessage = true;
    }

    private void Discard()
    {
        _s = _applied;
        _songLyrics = _songOriginalLyrics;
        _sel = null;
        _appliedMessage = false;
    }

    private void Reset() => Apply(ProjectionStyle.Default);

    private string GetColor(Target t) => t switch
    {
        Target.Title => _s.SongTitleColor,
        Target.Lyrics => _s.SongColor,
        Target.Chorus => _s.ChorusColor,
        Target.Paren => _s.ParenColor,
        Target.Men => _s.MenColor,
        Target.Women => _s.WomenColor,
        Target.BibleRef => _s.BibleRefColor,
        Target.BibleText => _s.BibleColor,
        _ => _s.ClockColor
    };

    private Task OnSwatch(string hex)
    {
        if (_sel is not null) return ColorTextAsync(hex);
        SetColor(hex);
        return Task.CompletedTask;
    }

    private void SetColor(string hex) => Apply(_target switch
    {
        Target.Title => _s with { SongTitleColor = hex },
        Target.Lyrics => _s with { SongColor = hex },
        Target.Chorus => _s with { ChorusColor = hex },
        Target.Paren => _s with { ParenColor = hex },
        Target.Men => _s with { MenColor = hex },
        Target.Women => _s with { WomenColor = hex },
        Target.BibleRef => _s with { BibleRefColor = hex },
        Target.BibleText => _s with { BibleColor = hex },
        _ => _s with { ClockColor = hex }
    });

    /// <summary>Letra, refrão, parênteses e vozes partilham o tamanho dos louvores; título, versículo e referência têm o seu.</summary>
    private double? SizeOf(Target t) => t switch
    {
        Target.Lyrics or Target.Chorus or Target.Paren or Target.Men or Target.Women => _s.SongMaxSizePct,
        Target.Title => _s.SongTitleMaxSizePct,
        Target.BibleText => _s.BibleMaxSizePct,
        Target.BibleRef => _s.BibleRefMaxSizePct,
        _ => null
    };

    private static (double Min, double Max) SizeRange(Target t) => t switch
    {
        Target.Title or Target.BibleRef => (3, 15),
        _ => (5, 18)
    };

    private void ChangeSize(int delta)
    {
        var (min, max) = SizeRange(_target);
        Apply(_target switch
        {
            Target.Title => _s with { SongTitleMaxSizePct = Math.Clamp(_s.SongTitleMaxSizePct + delta, min, max) },
            Target.BibleText => _s with { BibleMaxSizePct = Math.Clamp(_s.BibleMaxSizePct + delta, min, max) },
            Target.BibleRef => _s with { BibleRefMaxSizePct = Math.Clamp(_s.BibleRefMaxSizePct + delta, min, max) },
            _ => _s with { SongMaxSizePct = Math.Clamp(_s.SongMaxSizePct + delta, min, max) }
        });
    }

    /// <summary>Título e referência têm fonte própria; a letra e o versículo partilham a fonte do módulo.</summary>
    private string CurrentFont => _target switch
    {
        Target.Title => _s.SongTitleFont,
        Target.BibleRef => _s.BibleRefFont,
        _ => _mode == Mode.Bible ? _s.BibleFont : _s.SongFont
    };

    private static string FontLabel(Target t) => t switch
    {
        Target.Title => "do título",
        Target.BibleRef => "da referência",
        Target.BibleText => "da Bíblia",
        _ => "dos louvores"
    };

    /// <summary>Lista curta: fontes comuns que existem neste computador (+ a atual).</summary>
    private IEnumerable<string> FontChoices =>
        FontService.Suggested.Where(Fonts.IsInstalled).Append(CurrentFont).Distinct(StringComparer.CurrentCultureIgnoreCase);

    private void OnFont(ChangeEventArgs e)
    {
        var font = e.Value?.ToString() ?? string.Empty;
        Apply(_target switch
        {
            Target.Title => _s with { SongTitleFont = font },
            Target.BibleRef => _s with { BibleRefFont = font },
            _ => _mode == Mode.Bible ? _s with { BibleFont = font } : _s with { SongFont = font }
        });
    }

    /// <summary>Alinhamento do título (louvor) ou da referência (Bíblia) — faixa superior, não a letra/versículo.</summary>
    private string HeadingAlign => _target == Target.Title ? _s.SongTitleAlign : _s.BibleRefAlign;

    private void SetHeadingAlign(string align) => Apply(_target == Target.Title
        ? _s with { SongTitleAlign = align }
        : _s with { BibleRefAlign = align });

    /// <summary>Espaçamento entre linhas da letra (louvor) ou do versículo (Bíblia).</summary>
    private double LineHeight => _target == Target.BibleText ? _s.BibleLineHeight : _s.SongLineHeight;

    private void OnLineHeightInput(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v))
            return;
        v = Math.Clamp(v, 1, 2);
        Apply(_target == Target.BibleText ? _s with { BibleLineHeight = v } : _s with { SongLineHeight = v });
    }

    /// <summary>Posição vertical (topo da faixa, em % da altura do ecrã) do título (louvor) ou da referência (Bíblia).</summary>
    private double HeadingTop => _target == Target.Title ? _s.SongTitleTopPct : _s.BibleRefTopPct;

    private void OnHeadingTopInput(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v))
            return;
        v = Math.Clamp(v, 0, 50);
        Apply(_target == Target.Title ? _s with { SongTitleTopPct = v } : _s with { BibleRefTopPct = v });
    }

    /// <summary>Alinhamento → posição do texto na faixa (flex) na pré-visualização.</summary>
    private static string JustifyFor(string align) => align switch
    {
        "left" => "flex-start",
        "right" => "flex-end",
        _ => "center"
    };

    private string Cls(Target t, string extra = "") => $"pick {extra} {(t == _target ? "picked" : "")}".Trim();

    private string Bg(params BackgroundSlot[] slots)
    {
        var bg = slots.Select(Gallery.GetBackground).FirstOrDefault(b => b is { IsVideo: false });
        return bg is null ? "background: radial-gradient(ellipse at center, #1d3a6b 0%, #0b1733 70%, #050a18 100%)"
                          : $"background-image:url('{bg.Url}')";
    }

    /// <summary>
    /// Fundo do louvor em pré-visualização — mesma prioridade do telão real (ProjectionState.CurrentBackground):
    /// fundo PRÓPRIO deste louvor primeiro, só cai no fundo global da Galeria se o louvor não tiver um definido.
    /// Sem isto, a pré-visualização mostra uma imagem diferente da que vai realmente para o telão.
    /// </summary>
    private string SongBg()
    {
        var ownBackground = Media.Resolve(_song?.BackgroundFile);
        BackgroundMedia? bg = null;
        if (_slide == 0)
        {
            var ownFirstSlide = Media.Resolve(_song?.FirstSlideBackgroundFile);
            bg = ownFirstSlide ?? (ownBackground is null ? Gallery.GetBackground(BackgroundSlot.FirstSlide) : null);
        }
        bg ??= ownBackground ?? Gallery.GetBackground(BackgroundSlot.Slides);

        return bg is { IsVideo: false }
            ? $"background-image:url('{bg.Url}')"
            : "background: radial-gradient(ellipse at center, #1d3a6b 0%, #0b1733 70%, #050a18 100%)";
    }

    private static string Label(Target t) => t switch
    {
        Target.Title => "Título do louvor (na faixa)",
        Target.Lyrics => "Letra",
        Target.Chorus => "Refrão (CORO)",
        Target.Paren => "Texto entre parênteses — (2X), (BIS)…",
        Target.Men => "Voz dos homens — (H) / VARÕES",
        Target.Women => "Voz das mulheres — (M) / SERVAS",
        Target.BibleRef => "Referência (ex.: João 3:16)",
        Target.BibleText => "Versículo",
        _ => "Números do relógio/cronómetro"
    };

    private static string PaletteName(string hex) =>
        Palette.FirstOrDefault(p => string.Equals(p.Hex, hex, StringComparison.OrdinalIgnoreCase)).Name ?? hex;
}
